{
  "name": "piano-learning",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.10.0",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 200",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check",
    "check:deploy": "pnpm typecheck && pnpm lint && pnpm format:check",
    "dev": "node scripts/dev/start-dev.mjs",
    "dev:local": "vite --host 127.0.0.1 --port 6136 --strictPort",
    "dev:open": "vite --host 127.0.0.1 --port 6136 --strictPort --open http://127.0.0.1:6136/",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 6136 --strictPort --open http://127.0.0.1:6136/",
    "test": "vitest run",
    "prepare": "husky"
  },
  "dependencies": {
    "@audio/pitch-yin": "1.0.5",
    "@radix-ui/react-alert-dialog": "^1.1.24",
    "@radix-ui/react-switch": "^1.3.8",
    "@vitejs/plugin-react": "^4.7.0",
    "dexie": "^4.4.4",
    "echarts": "^6.1.0",
    "lucide-react": "^0.468.0",
    "onnxruntime-web": "1.27.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sonner": "^2.0.8",
    "tone": "^15.5.27",
    "vexflow": "^5.0.0",
    "webmidi": "^3.1.16"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^24.13.2",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.5",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^6.4.3",
    "vitest": "^2.1.9"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --max-warnings 0 --fix",
      "prettier --write"
    ],
    "*.{json,md,css,html}": "prettier --write",
    "*.{yaml,yml}": "prettier --write"
  }
}
